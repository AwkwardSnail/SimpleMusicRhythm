<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleMusicRhythm</RootNamespace>
    <AssemblyName>SimpleMusicRhythm</AssemblyName>
    <Product>SimpleMusicRhythm</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Packaging\Assets\SimpleMusicRhythm.ico</ApplicationIcon>
    <!-- The app is English only; leave out .NET's translated messages so the
         Store doesn't list languages SimpleMusicRhythm doesn't support. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaging scripts are tools, not part of the app. -->
    <Compile Remove="Packaging\**" />
    <Resource Include="Packaging\Assets\SimpleMusicRhythm.ico" />
    <Resource Include="Packaging\Assets\Square44x44Logo.scale-400.png" />
  </ItemGroup>

</Project>
