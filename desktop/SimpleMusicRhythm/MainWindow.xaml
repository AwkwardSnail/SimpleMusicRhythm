<Window x:Class="SimpleMusicRhythm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SimpleMusicRhythm.Controls"
        Title="SimpleMusic Rhythm" Width="1200" Height="900" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Packaging/Assets/SimpleMusicRhythm.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid Margin="20,14,20,18" Background="{StaticResource BgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource GhostButton}" Content="?" FontWeight="Bold" MinWidth="38" Padding="0"
                AutomationProperties.Name="Keyboard shortcuts" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
          <Button.ToolTip>
            <TextBlock LineHeight="22" Margin="4">
              <Run FontWeight="SemiBold">Keyboard shortcuts</Run><LineBreak/>
              N   add a note<LineBreak/>
              R   add a rest<LineBreak/>
              1 – 5   whole, half, quarter, eighth, sixteenth<LineBreak/>
              .   dotted on / off<LineBreak/>
              ← →   move between notes<LineBreak/>
              Delete / Backspace   remove a note<LineBreak/>
              Esc   deselect<LineBreak/>
              Space   play / stop<LineBreak/>
              M   metronome on / off<LineBreak/>
              Ctrl+Z / Ctrl+Y   undo / redo<LineBreak/>
              Ctrl+N / Ctrl+O   new sheet / open a sheet<LineBreak/>
              Ctrl+S / Ctrl+Shift+S   save / save a copy as<LineBreak/>
              Ctrl+P / Ctrl+M   export PDF / export MIDI
            </TextBlock>
          </Button.ToolTip>
        </Button>
        <Button Style="{StaticResource GhostButton}" Content="New" Click="OnNewSheet" ToolTip="Start a new, empty sheet (Ctrl+N)"/>
        <Button Style="{StaticResource GhostButton}" Content="Open…" Click="OnOpen" ToolTip="Open a saved sheet (Ctrl+O)"/>
        <Button Style="{StaticResource GhostButton}" Content="Save" Click="OnSave" ToolTip="Save this sheet (Ctrl+S)"/>
        <Button Style="{StaticResource GhostButton}" Content="Save as…" Click="OnSaveAs" ToolTip="Save a copy under a new name (Ctrl+Shift+S)"/>
        <Button x:Name="BtnExport" Style="{StaticResource GhostButton}" Content="Export  ▾" Click="OnExportMenu"
                ToolTip="Export the sheet as a PDF or a MIDI file">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="PDF — to print or share…" InputGestureText="Ctrl+P" Click="OnExportPdf"/>
              <MenuItem Header="MIDI — to play in other music apps…" InputGestureText="Ctrl+M" Click="OnExportMidi"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Image Source="Packaging/Assets/Square44x44Logo.scale-400.png" Width="48" Height="48" Margin="0,0,12,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SimpleMusic Rhythm" FontSize="21" FontWeight="Bold"/>
          <TextBlock Text="Write your rhythm first. Count the bars later." Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Step 1: write -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Border Style="{StaticResource StepNumber}">
            <TextBlock Text="1" Foreground="{StaticResource CardBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="Write your rhythm" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Pick a note length, then click on the line to place a note. Don't worry about bars yet." Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
          <StackPanel Margin="0,0,22,8">
            <TextBlock Style="{StaticResource GroupLabel}" Text="NOTE LENGTH"/>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="DurW" Style="{StaticResource ToolToggle}" Tag="W" Click="OnDurClick" ToolTip="Whole note (key 1)"><c:NoteIcon x:Name="IconW" Dur="W"/></ToggleButton>
              <ToggleButton x:Name="DurH" Style="{StaticResource ToolToggle}" Tag="H" Click="OnDurClick" ToolTip="Half note (key 2)"><c:NoteIcon x:Name="IconH" Dur="H"/></ToggleButton>
              <ToggleButton x:Name="DurQ" Style="{StaticResource ToolToggle}" Tag="Q" Click="OnDurClick" ToolTip="Quarter note (key 3)"><c:NoteIcon x:Name="IconQ" Dur="Q"/></ToggleButton>
              <ToggleButton x:Name="DurE" Style="{StaticResource ToolToggle}" Tag="E" Click="OnDurClick" ToolTip="Eighth note (key 4)"><c:NoteIcon x:Name="IconE" Dur="E"/></ToggleButton>
              <ToggleButton x:Name="DurS" Style="{StaticResource ToolToggle}" Tag="S" Click="OnDurClick" ToolTip="Sixteenth note (key 5)"><c:NoteIcon x:Name="IconS" Dur="S"/></ToggleButton>
            </StackPanel>
          </StackPanel>

          <StackPanel Margin="0,0,22,8">
            <TextBlock Style="{StaticResource GroupLabel}" Text="OPTIONS"/>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="BtnDot" Style="{StaticResource ToolToggle}" Click="OnDotClick" ToolTip="Dotted: makes the note half as long again (key .)">
                <StackPanel Orientation="Horizontal">
                  <c:NoteIcon Dur="Q" Dotted="True" Margin="0,0,4,0"/>
                  <TextBlock Text="Dotted" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="BtnRest" Style="{StaticResource ToolToggle}" Click="OnRestClick" ToolTip="Rest mode: clicks add silences instead of notes (key R adds a rest)">
                <StackPanel Orientation="Horizontal">
                  <c:NoteIcon IsRest="True" Margin="0,0,4,0"/>
                  <TextBlock Text="Rest" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </StackPanel>

          <StackPanel Margin="0,0,22,8">
            <TextBlock Style="{StaticResource GroupLabel}" Text="EDIT"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnUndo" Style="{StaticResource ToolButton}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" Content="↶  Undo"/>
              <Button x:Name="BtnRedo" Style="{StaticResource ToolButton}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" Content="↷  Redo"/>
              <Button x:Name="BtnDelete" Style="{StaticResource ToolButton}" Click="OnDelete" ToolTip="Delete the selected note (Delete / Backspace)" Content="✕  Delete"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource GroupLabel}" Text="LISTEN"/>
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="BtnPlay" Style="{StaticResource PlayToggle}" Click="OnPlayClick" ToolTip="Play the rhythm / stop (Space)" MinWidth="80" Content="▶  Play"/>
              <ToggleButton x:Name="BtnMetronome" Style="{StaticResource ToolToggle}" Click="OnMetronomeClick" Margin="6,0,0,0"
                            ToolTip="Metronome on its own, in the time signature below; the first beat of each bar clicks higher (M)" Content="Metronome"/>
              <Slider x:Name="Tempo" Minimum="40" Maximum="200" Width="120" VerticalAlignment="Center" Focusable="False"
                      IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnTempoChanged" Margin="6,0,8,0" ToolTip="Speed in beats per minute"/>
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13">
                <Run x:Name="TempoText" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="90"/> bpm
              </TextBlock>
              <CheckBox x:Name="ClickAlong" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" Focusable="False"
                        Content="Click along" ToolTip="Play the metronome clicks with the rhythm"/>
            </StackPanel>
          </StackPanel>
        </WrapPanel>

        <!-- The paper -->
        <Border Grid.Row="2" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="16,14,16,0">
              <TextBlock x:Name="TitlePlaceholder" Text="Untitled rhythm" FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                         Foreground="#B9B4BF" HorizontalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="TitleBox" FontFamily="Georgia" FontSize="22" FontWeight="Bold" TextAlignment="Center"
                       Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="Transparent" MaxLength="120"
                       TextChanged="OnTitleChanged" KeyDown="OnTitleKeyDown" ToolTip="Give your rhythm a title"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="1,0,1,6">
              <c:ScoreView x:Name="Score"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,10,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <!-- Step 2: bars -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Border Style="{StaticResource StepNumber}">
            <TextBlock Text="2" Foreground="{StaticResource CardBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="Divide into bars" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Choose how many beats fit in each bar and which note counts as one beat. Notes that cross a bar line are split and tied for you."/>
          </StackPanel>
        </StackPanel>

        <DockPanel LastChildFill="False">
          <Button x:Name="BtnBar" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="OnBarClick" Content="Divide into bars" VerticalAlignment="Bottom"/>

          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource GroupLabel}" Text="BEATS IN EACH BAR"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Background="{StaticResource PaperBrush}" Height="42">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource StepperButton}" Content="−" Click="OnBeatsMinus" ToolTip="Fewer beats"/>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0" Width="48">
                  <TextBlock x:Name="BeatsText" Text="4" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource StepperButton}" Content="+" Click="OnBeatsPlus" ToolTip="More beats"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource GroupLabel}" Text="ONE BEAT IS A"/>
            <ComboBox x:Name="BeatUnit" Width="84" Height="42" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      Padding="12,0" SelectionChanged="OnBeatUnitChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <c:NoteIcon Dur="{Binding Dur}" Dotted="{Binding Dot}" Margin="6,2"
                              ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource GroupLabel}" Text="TIME SIGNATURE"/>
            <StackPanel HorizontalAlignment="Center" Margin="0,-4,0,0">
              <TextBlock x:Name="TsNum" Text="4" FontFamily="Georgia" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,-8"/>
              <TextBlock x:Name="TsDen" Text="4" FontFamily="Georgia" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <CheckBox x:Name="FillLast" Content="Fill the last bar with rests" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    VerticalContentAlignment="Center" Focusable="False" Click="OnFillLastClick"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
