<Application x:Class="SimpleMusicRhythm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#F4F1EA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1D1B22"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B6774"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E4DFD3"/>
    <SolidColorBrush x:Key="LineHoverBrush" Color="#C9C2B2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F5BD3"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6EDFF"/>
    <SolidColorBrush x:Key="PlayBrush" Color="#E2662B"/>
    <SolidColorBrush x:Key="PlaySoftBrush" Color="#FFF1EA"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="1,0,0,5"/>
    </Style>

    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource InkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- Toolbar buttons -->
    <Style x:Key="ToolBase" TargetType="ButtonBase">
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource LineHoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ToolBase}"/>

    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolBase}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlayToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolBase}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource PlaySoftBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource PlayBrush}"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Foreground" Value="{StaticResource PlayBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ToolBase}">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolBase}">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource ToolBase}">
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="18"/>
    </Style>
  </Application.Resources>
</Application>
